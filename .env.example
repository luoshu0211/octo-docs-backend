# ── Server ──────────────────────────────────────────────────────────────────
HOSTNAME=octo-docs-local
# Hocuspocus collaborative WS server port (§2.1)
HOCUSPOCUS_PORT=1234
# REST metadata API port (§8.4)
HTTP_PORT=3000
# Optional SECOND listener that serves ONLY the routes whose every caller is
# inside our own container network. Today that is exactly one prefix:
# /internal/html (the html service registering published docs with the shared
# internal token). Empty or 0 = disabled: one listener serves every surface,
# exactly as before.
#
# Set it (9090 by convention) and HTTP_PORT above keeps serving every route that
# has an out-of-network caller: /api/v1/docs, /api/v1/ppt, the signed attachment
# blob gateway, /v1/bot/docs (published through the public gateway today; its
# bot-token clients are not all ours) and /api/v1/card-actions/decide (octo-server
# may live off our network; the HMAC is the authenticator, not network position).
# Each port 404s the other's routes.
#
# Deployment rules when enabled:
#   - compose: `expose: ["9090"]` — NEVER `ports:` (publishing it to the host
#     defeats the entire point). Same trap with network_mode: host / bare metal /
#     macvlan — there set INTERNAL_HTTP_HOST=127.0.0.1.
#   - nginx: 9090 must not appear in any upstream/server block.
#   - ONE caller to repoint, the html service — and it needs a SECOND variable,
#     not a changed one. Keep the existing base on 3000 and add the dedicated
#     internal endpoint:
#       DOCS_BACKEND_REGISTER_URL=http://octo-docs-backend:3000/v1/bot/docs
#       DOCS_BACKEND_INTERNAL_REGISTER_URL=http://octo-docs-backend:9090/internal/html/register
#     Do NOT just repoint DOCS_BACKEND_REGISTER_URL at 9090: in octo-docs-html it
#     is the base for three bot-face calls (register/rename/delete) AND the
#     derivation source for the internal endpoint, so moving it breaks the bot
#     face while leaving it breaks user-publish registration. Needs
#     octo-docs-html#37. No octo-server change and no bot-client change is needed.
#   - must be 0 or a real port in 1..65535, and must differ from both HTTP_PORT
#     and HOCUSPOCUS_PORT, or boot fails (a typo must not silently disable the
#     split); a bind failure on either listener exits the process rather than
#     serving a half-split container.
# This reduces attack surface; it is NOT an auth boundary — the internal token
# check stays mandatory on this port.
INTERNAL_HTTP_PORT=0
# Bind address for the internal listener. 0.0.0.0 (default) is correct on a
# compose/k8s bridge network, where an un-published port is reachable only from
# sibling containers. Set 127.0.0.1 under network_mode: host, bare metal, or
# macvlan — there 0.0.0.0 makes the internal port host-reachable.
# INTERNAL_HTTP_HOST=0.0.0.0
# Express `trust proxy` setting (§8.4). The REST API runs behind nginx, so this
# must be set for req.ip — and the per-IP rate limiter — to see the real client
# from X-Forwarded-For rather than the proxy. `1` = one nginx hop (default);
# use the hop count for deeper proxy chains, a CIDR/preset like `loopback`, or
# `false` only when the app is exposed directly. Avoid `true` in prod (permissive:
# lets clients spoof X-Forwarded-For).
TRUST_PROXY=1

# ── CORS (XIN-717) ────────────────────────────────────────────────────────────
# Comma-separated allowlist of front-end origins permitted to call the REST API
# and (with the local-hmac driver pointed at this backend origin) the presigned
# attachment PUT/GET. The browser preflights cross-origin requests with OPTIONS
# and blocks any response whose Access-Control-Allow-Origin does not match, so
# the FE origin MUST be listed here or image upload/download fails. Use exact
# origins (scheme + host + port), e.g. `http://192.168.214.189:3010`, or the
# single value `*` to reflect any origin. Empty (default) allows no cross-origin
# request — set it per environment at deploy time.
# CORS_ALLOWED_ORIGINS=

# ── Rate limiting (§8.4) ──────────────────────────────────────────────────────
# Per-IP throttle on the REST route chains (human /api/v1/docs + bot /v1/bot/docs).
# /healthz is never throttled. Requires TRUST_PROXY set correctly to key per client.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# ── MySQL (authoritative store, §3.4) ─────────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=octo_docs
MYSQL_PASSWORD=octo_docs
MYSQL_DATABASE=octo_docs
MYSQL_CONNECTION_LIMIT=10

# ── Redis (pub/sub broadcast bus + epoch cache + connection registry, §5) ─────
# Optional URL; when non-empty it overrides ALL connection fields below.
# Percent-encode username/password components, not the entire URL.
# REDIS_URL=redis://:example-password@redis.internal:6379/0
# REDIS_URL=rediss://docs-user:example-password@redis.internal:6379/0
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
# Key AND Pub/Sub namespace (§2.1 / §5.1): Redis DB does not isolate Pub/Sub.
REDIS_PREFIX=octo-docs

# ── collab token JWT (§4.4) ───────────────────────────────────────────────────
# docs backend private signing secret for the short-lived collab JWT.
# In production use an asymmetric key / KMS; HS256 secret is for dev only.
COLLAB_TOKEN_SECRET=dev-only-change-me
# collab token TTL in seconds (default 5 minutes per §4.4)
COLLAB_TOKEN_TTL_SECONDS=300
# Temporary two-stage Home-Space rollout switch. New instances ALWAYS issue the
# proof. Set true only while pre-hotfix tokens drain; after every old issuer is
# gone, wait at least COLLAB_TOKEN_TTL_SECONDS, then set false and redeploy.
COLLAB_ALLOW_LEGACY_TOKENS_WITHOUT_HOME_SPACE_PROOF=false
# Public URL on the existing Web gateway, required in production.
# /docs-collab routes to Hocuspocus 1234; /api/v1/ppt/collab routes to Docs HTTP 3000.
# PPT derives the second path from this URL's origin, so no second public URL is
# required with this gateway. Direct-port Hocuspocus or separate-origin PPT
# deployments MUST set PPT_RELAY_PUBLIC_WS_URL to the public Docs HTTP WS endpoint.
# Direct-port local example: ws://localhost:3000/api/v1/ppt/collab for PPT,
# alongside COLLAB_TOKEN_PUBLIC_WS_URL=ws://localhost:1234 for Hocuspocus.
COLLAB_TOKEN_PUBLIC_WS_URL=wss://web.example.com/docs-collab

# ── octo identity integration (§4.7) ──────────────────────────────────────────
# Identity mode: "http" (cross-service, calls POST /v1/auth/verify) or
# "middleware" (same-process mount behind octo AuthMiddleware — placeholder).
OCTO_IDENTITY_MODE=http
# Base URL of octo-server for the cross-service token introspection fallback.
OCTO_SERVER_BASE_URL=http://127.0.0.1:8080
# Backend service token for octo-server. The backend makes server-side
# octo-server calls: the add-member / forward-grant uid existence check (anti
# ghost-member) in members.ts / forwardGrant.ts.
#   - Human path (/api/v1/docs): OPTIONAL. Human directory lookups prefer
#     this service token when configured and otherwise use the caller's session
#     token; collaborator name/avatar display is unaffected (the frontend fetches
#     those from octo-server directly).
#   - Bot member-add/update: NOT REQUIRED. If principalSpaceId is omitted, it
#     defaults to the Bot bearer-authenticated Space (not the document Home Space)
#     and the exact target is validated with the Bot bearer. If another Space is
#     explicitly selected, no current directory-membership/eligibility check is
#     made; only an already-existing exact row can have its role updated.
#   - Member delete: NOT REQUIRED for Bot-mounted DELETE, which removes only the
#     exact (docId, uid, principalSpaceId) row without lookup or cascade. Human-
#     mounted DELETE follows the service-token-first directory policy above for
#     its creator-owned-Bot cascade.
# Bot-realm operations such as forward-grant may use the Bot bearer against
# /v1/bot/user/info and do not depend on this token for that lookup.
OCTO_SERVER_TOKEN=

# ── attachments (§3.5) ────────────────────────────────────────────────────────
# Object storage bucket for presigned attachment uploads.
ATTACHMENT_BUCKET=octo-docs-attachments
# Presign driver: 'local-hmac' (default, zero-dependency dev signing) or
# 's3'/'minio' (real AWS SigV4 presigned URLs against an S3-compatible endpoint).
ATTACHMENT_DRIVER=local-hmac
# Optional object-key prefix prepended to every key before signing, so several
# apps can share one bucket (e.g. a Tencent COS bucket shared with octo-server).
# Empty = unprefixed (default; no change for existing deployments).
# ATTACHMENT_KEY_PREFIX=
# Public, browser-reachable base URL the 'local-hmac' driver bakes into the
# signed PUT/GET URL host. The front-end uploads/downloads directly, so this host
# MUST resolve from the end-user browser. Empty (default) uses the legacy
# `https://<bucket>.object-store.local` origin — an internal alias the browser
# cannot resolve (ERR_NAME_NOT_RESOLVED), which breaks cross-device image upload
# (XIN-713). Set it to a reachable host, e.g. the docs-backend origin that fronts
# object storage (`http://<host>:<HTTP_PORT>`) or a real object-store endpoint.
# An optional path segment (e.g. `.../attachments`) is supported. Do NOT commit a
# LAN IP here — set it per-environment at deploy time.
# ATTACHMENT_PUBLIC_BASE_URL=
# Filesystem directory the self-hosted local-hmac blob gateway stores/serves
# uploaded bytes from (XIN-717). Only used when ATTACHMENT_DRIVER=local-hmac AND
# ATTACHMENT_PUBLIC_BASE_URL points at this backend origin, i.e. the browser
# PUTs/GETs the binary directly here. Empty (default) uses
# `<os.tmpdir()>/octo-docs-attachments`. Ignored by the s3/minio drivers.
# ATTACHMENT_LOCAL_DIR=
# HMAC key for the 'local-hmac' driver (signs objectKey + expiry). Dev fallback
# is 'dev-only-change-me'; it MUST be overridden in production — the process
# refuses to start with the dev default when NODE_ENV=production, for ANY driver.
ATTACHMENT_SIGNING_SECRET=dev-only-change-me
# ── S3-compatible (MinIO/S3/COS) driver — used only when ATTACHMENT_DRIVER=s3|minio ─
# Public, browser-reachable endpoint baked into the signed URL host. Do NOT point
# this at a docker-internal alias.
ATTACHMENT_S3_ENDPOINT=http://localhost:9000
ATTACHMENT_S3_REGION=us-east-1
# Credentials — supply real values via env at runtime; never commit them.
ATTACHMENT_S3_ACCESS_KEY=<access-key>
ATTACHMENT_S3_SECRET_KEY=<secret-key>
# Addressing: true (default) = path-style `<endpoint>/<bucket>/<key>` (MinIO).
# false = virtual-hosted / custom-domain `<endpoint>/<key>` (host already bound
# to the bucket, e.g. a Tencent COS CDN domain) — drops the bucket from the path
# and the SigV4 canonicalUri.
# ATTACHMENT_S3_FORCE_PATH_STYLE=true
# Host signed in the SigV4 `host` header when it differs from the endpoint host.
# A COS CDN/custom domain origin-pulls to the bucket with the Host rewritten to
# `<bucket>.cos.<region>.myqcloud.com`, and COS validates against THAT host — set
# this to the origin host while ATTACHMENT_S3_ENDPOINT stays the custom domain.
# Empty (default) signs the endpoint host (MinIO/S3, or COS on its origin).
# ATTACHMENT_S3_SIGNING_HOST=
# Container-network endpoint for server-side PUT/GET/DELETE (import, copy,
# svg upload, markdown ingest, delete, and PDF/Typst, DOCX, and board export
# image reads). In dockerised deployments the public endpoint above (e.g.
# http://127.0.0.1:28090 — an nginx reverse-proxy bound to the host loopback) is
# unreachable from inside the backend container; set this to the in-cluster
# S3/MinIO address (e.g. http://minio:9000) so server-side media operations stay
# on the container network.
#
# For the COS-behind-CDN deployment described under ATTACHMENT_S3_SIGNING_HOST,
# prefer the COS bucket origin here (e.g.
# https://<bucket>.cos.<region>.myqcloud.com) so server-side requests bypass the
# CDN. It may remain unset only when the CDN is reachable from the server and
# performs the documented Host rewrite. Empty falls back to ATTACHMENT_S3_ENDPOINT.
# ATTACHMENT_S3_INTERNAL_ENDPOINT=
# Tiered size caps (bytes). Tier is chosen by the backend from the 'image/' mime
# prefix; both tiers hard-cap. Defaults: 10MB image, 50MB file.
ATTACHMENT_MAX_IMAGE_SIZE_BYTES=10485760
ATTACHMENT_MAX_FILE_SIZE_BYTES=52428800
# Presigned PUT (upload) URL TTL and re-issued signed GET (read) URL TTL, seconds.
ATTACHMENT_UPLOAD_URL_TTL_SECONDS=300
ATTACHMENT_READ_URL_TTL_SECONDS=600
# Hard cap on the batch resolve endpoint (over-cap requests are rejected).
ATTACHMENT_MAX_RESOLVE_BATCH=200
# Allowed MIME list. Entry ending in '/' = prefix match; otherwise exact match.
# ATTACHMENT_ALLOWED_MIME_PREFIXES=image/,application/pdf,text/plain,...
# Denylist (takes precedence over the allow list); HTML/script/executable/SVG.
# ATTACHMENT_BLOCKED_MIMES=image/svg+xml,text/html,application/javascript,...

# ── PPT (html_ppt) source/bootstrap (XIN-1495 R3-B1) ─────────────────────────
# TTL (seconds) for the short-lived SIGNED asset GET URLs embedded in a PPT
# bootstrap payload. Mirrors C's ~15-minute authorized-render window. No
# long-lived token is ever placed in the URL; the client refreshes via one
# bootstrap re-fetch when a URL 403/404s.
PPT_ASSET_URL_TTL_SECONDS=900

# ── PPT (html_ppt) Bento collab relay (XIN-1495 R4-B1 §7) ────────────────────
# The Bento-frame WS relay is hosted INSIDE the REST server on the
# `/api/v1/ppt/collab` upgrade path (no second service). These knobs cover the
# collab-token/ticket issuance and the relay's protocol/limit envelope.
# PPT is enabled with the service, using existing MySQL/Redis configuration.
# The public endpoint derives from COLLAB_TOKEN_PUBLIC_WS_URL with path
# /api/v1/ppt/collab when the shared Web gateway routes it to Docs HTTP 3000.
# PPT_RELAY_PUBLIC_WS_URL is required for direct-port/separate-origin deployments.
# Optional rollback and public endpoint override:
# PPT_RELAY_ENABLED=false
# PPT_RELAY_PUBLIC_WS_URL=wss://web.example.com/api/v1/ppt/collab
# Bento CRDT sync protocol version the relay speaks; a frame whose `pv` differs
# is refused `protocol-version` before any decode. Mirrors ppt_doc_state.bento_sync_pv.
PPT_RELAY_SYNC_PV=2
# One-time WS handshake ticket TTL (seconds). Short: a leaked/replayed ticket is
# useless quickly. The ticket is single-use across nodes via the Redis store.
PPT_RELAY_TICKET_TTL_SECONDS=30
# Relay limit envelope (Bento upstream defaults; load-test before production).
# Per-op-frame wire-byte cap (too-large, permanent).
PPT_RELAY_MAX_FRAME_BYTES=1900000
# Max ops per persisted frame (too-large, permanent).
PPT_RELAY_MAX_OPS_PER_FRAME=512
# Sliding-window rate limit: max persisted frames per window (rate-limited, retryable).
PPT_RELAY_MAX_FRAMES_PER_WINDOW=200
PPT_RELAY_RATE_WINDOW_MS=10000
# Per-snapshot blob cap (bytes); larger than the op-frame cap so a legitimate
# snapshot is not pre-empted by it (too-large, permanent).
PPT_RELAY_MAX_SINGLE_BLOB_BYTES=8388608
# Per-room durable frame-byte budget (room-full, permanent).
PPT_RELAY_MAX_ROOM_FRAME_BYTES=100663296
# Byte cap for ephemeral frames (hello/need/p/bye); far tighter than the op/blob
# caps since these carry only a small resume cursor or presence payload.
PPT_RELAY_MAX_EPHEMERAL_FRAME_BYTES=65536
# Max live frames/bytes buffered while a connection is replaying. Overflow closes
# the socket with 4410 `resync required`; the relay never silently drops frames.
PPT_RELAY_MAX_LIVE_BUFFER_FRAMES=4096
PPT_RELAY_MAX_LIVE_BUFFER_BYTES=8388608
# Replay cursor pool reservation. Leave UNSET to use the derived default
# max(1,min(2,floor(MYSQL_CONNECTION_LIMIT/4))). If set, it is clamped to
# MYSQL_CONNECTION_LIMIT-1 (a value >= the pool size is clamped with a warning,
# not a boot failure). Only override when you have measured the pool headroom;
# a hardcoded value that outgrows a shrunken MYSQL_CONNECTION_LIMIT is the
# boot-trap this example intentionally avoids by staying commented out.
# PPT_RELAY_MAX_IN_FLIGHT_REPLAYS=2
# Max time (ms) a join waits for a replay slot before it is refused `storage-retry`.
# PPT_RELAY_REPLAY_ACQUIRE_TIMEOUT_MS=10000
# Inbound frame queue depth cap per connection; frames beyond it are shed
# `rate-limited` rather than growing an unbounded persist backlog.
# PPT_RELAY_MAX_INBOUND_QUEUE=256
# Outbound frame queue depth cap per connection; a non-reading peer whose queued
# frames exceed it is closed 4410 (resync) rather than growing an unbounded send
# backlog in the process that also serves the REST API.
# PPT_RELAY_MAX_OUTBOUND_QUEUE=2048
# Retention window (room seqs) for the dedup ledger `ppt_collab_frame`. The ledger
# outlives the pruned op row so a resend after a lost ack re-acks its original seq,
# but with no retention it grew forever. Ledger rows are reclaimed only when they fall
# this many seqs behind the covered watermark, bounding the table to ~this many rows
# per doc. Large by default: an idempotent resend happens within seconds, far inside
# the window.
# PPT_RELAY_LEDGER_RETENTION_FRAMES=262144
# Seq-lag cap after which the snapshotter ages out a permanently-buffered op to
# unfreeze GC. Operator-tunable: lower it so a room whose average frame is large forces
# the reclaim on seq lag before the byte budget (`room-full`) trigger fires.
# PPT_RELAY_MAX_BUFFERED_OP_LAG=4096
# Max op rows and persisted JSON bytes read per replay page; the relay sends one
# page and waits for outbound progress before fetching the next page.
PPT_RELAY_REPLAY_PAGE_SIZE=1000
PPT_RELAY_REPLAY_PAGE_BYTES=4194304
# Socket bufferedAmount (bytes) above which replay pauses before its next send, so
# one slow consumer cannot make the relay accumulate an unbounded send backlog.
PPT_RELAY_SEND_HIGH_WATER_BYTES=4194304
PPT_RELAY_SEND_DRAIN_TIMEOUT_MS=5000
# Periodic read-auth refresh and short doc-status cache TTL.
PPT_RELAY_AUTH_REFRESH_MS=5000
PPT_RELAY_DOC_STATUS_CACHE_TTL_MS=2000

# Grace window (ms) for a share-derived socket whose ticket membership claim just
# expired to present a freshly-minted ticket via an in-place `reauth` frame before
# the relay fails closed. Keep it ABOVE PPT_RELAY_AUTH_REFRESH_MS (production
# ordering) so a periodic read-auth refresh fires inside the window without
# clearing the pending-reauth state.
PPT_RELAY_REAUTH_GRACE_MS=10000

# ── link-card OG fetch (§3.5 ⑰) ───────────────────────────────────────────────
# Outbound OG fetch is SSRF-guarded. These bound the request and the result cache.
OG_FETCH_TIMEOUT_MS=5000
OG_MAX_RESPONSE_BYTES=524288
OG_MAX_REDIRECTS=3
OG_USER_AGENT=octo-docs-linkcard/1.0 (+bot)
OG_ALLOWED_PORTS=80,443
OG_CACHE_SUCCESS_TTL_SECONDS=86400
OG_CACHE_FAILURE_TTL_SECONDS=300

# ── limits (§9.5) ─────────────────────────────────────────────────────────────
# Single-document Yjs state hard cap in bytes (§9.5, ~5-10MB band). Default 10MB.
MAX_DOC_BYTES=10485760

# Sheet PATCH JSON cap and per-map entry cap. Other JSON routes remain at 1 MiB.
SHEET_WRITE_MAX_REQUEST_BYTES=3145728
SHEET_WRITE_MAX_CELLS=20000

# ── auto-save version history (§5.7) ──────────────────────────────────────────
# Backend-autonomous auto snapshots off the Hocuspocus store path. Default OFF
# (gray release); when disabled the hooks are inert.
AUTO_SNAPSHOT_ENABLED=false
# "stopped typing" idle window (ms) before a clean restore point is taken.
AUTO_IDLE_MS=15000
# Minimum spacing (ms) between two auto snapshots, so continuous editing still
# snapshots periodically.
AUTO_MIN_INTERVAL_MS=60000
# Retention: keep at most the most-recent N auto rows per doc.
AUTO_RETAIN_COUNT=50
# Retention: drop auto rows older than this many days.
AUTO_RETAIN_DAYS=7

# ── full-text search (query side, §3.3) ──────────────────────────────────────
# Master switch. false (default) => POST /docs/search returns 503 (search
# unavailable) and never connects to OpenSearch. Gray-release gate.
SEARCH_ENABLED=false
# OpenSearch node URL (single node; same cluster the indexer writes to).
OPENSEARCH_NODE=http://127.0.0.1:9200
# Index the indexer writes doc bodies to (query side reads from it).
OPENSEARCH_INDEX=octo-doc
# Optional basic-auth credentials. Empty (default) => no auth header.
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
# TLS escape hatch for an https node with an untrusted (e.g. self-signed) cert.
# true (default) = verify against the system trust store (self-signed rejected).
# Set false ONLY for a trusted internal https endpoint you can't validate;
# ignored for http nodes.
OPENSEARCH_TLS_REJECT_UNAUTHORIZED=true
# Upper bound a caller's search pageSize is clamped to.
SEARCH_PAGE_SIZE_MAX=50
# Upper bound on the visible-doc-id set pushed down as an OpenSearch `terms
# doc_id` filter. Guards against exceeding the index's `index.max_terms_count`
# (OpenSearch default 65536): an oversized set fails deterministically with a
# 503 terms_limit_exceeded instead of an opaque OS error. Keep <= the index's
# configured max_terms_count.
SEARCH_MAX_VISIBLE_TERMS=65536
# Producer side: the afterStoreDocument / rename hooks send a tiny
# {documentName,kind,ts} signal to the Kafka topic below for a separate indexer
# to consume. false (default) = hook inert (nothing produced before a consumer
# exists). Deploy the consumer BEFORE flipping this on.
SEARCH_INDEX_ENABLED=false

# ── Kafka (search doc-index signal channel, §3.3a) ────────────────────────────
# Comma-separated broker list (host:port,host:port). Set per environment.
KAFKA_BROKERS=127.0.0.1:9092
# Topic the doc-index signal is produced to. MUST match the indexer's
# DOCINDEX_KAFKA_TOPIC. Change only in lockstep with the indexer deployment.
DOCINDEX_KAFKA_TOPIC=octo.docindex.v1
# Produce ack level: 1 = leader ack (default), 0 = fire-and-forget, -1 = all
# in-sync replicas. Kept low: best-effort side channel, consumer re-reads by key.
KAFKA_ACKS=1
# Dedicated credential for POST /internal/html/register (trusted service calls only).
OCTO_DOCS_HTML_REGISTRATION_TOKEN=

# --- Drive-library-derived viewer access (TES-131) ---
# Third read-permission source: when a doc lives inside a drive library the
# caller can reach, the drive service derives a READER grant even with no
# doc_member row / share. In-network only (docs<->drive service-to-service).
# Master on/off switch (default false). When false NO drive lookup is made and
# the effective role is byte-identical to pre-feature. Accepts true|false|1|0
# only (a typo fails startup), mirroring PPT_RELAY_ENABLED.
DRIVE_DERIVED_ENABLED=false
# Base URL of the internal drive service the derived-access lookup POSTs to
# (`<base>/internal/v1/docs/derived-access`). Empty => the lookup is a no-op
# (no derived access) even when enabled, so a half-configured deploy fails closed
# instead of erroring on every read. In-network only; not browser-reachable.
DRIVE_INTERNAL_BASE_URL=
# Per-request timeout (ms) for the derived-access lookup. Kept tight: it sits on
# the read/authorize hot path, so a hung drive service aborts fast and fails
# closed. Default 500.
DRIVE_DERIVED_TIMEOUT_MS=500
# Short-TTL cache window (ms) for a CONFIRMED derived-access answer, per
# (doc, uid, principal space), to bound drive QPS on hot docs. A drive-side
# revocation takes at most this long to propagate. Default 15000.
DRIVE_DERIVED_TTL_MS=15000
# Inbound internal token: compared (timing-safe) on the inbound
# GET /internal/docs/:docId/role that the drive service calls. Authority is on
# the DOCS side — docs generates/rotates this value and syncs it to drive's
# `DRIVE_DOCS_INTERNAL_TOKEN`. Empty => the internal role endpoint rejects every
# caller (fail-closed). Independent from DRIVE_INTERNAL_TOKEN (no fallback).
# NEVER logged.
DOCS_INTERNAL_TOKEN=
# Outbound internal token: sent as X-Internal-Token on the outbound
# derived-access lookup to the drive service. Authority is on the DRIVE side —
# docs holds a copy that must match drive's top-level `internal_token`. Empty =>
# the outbound client omits the header, so the lookup fails closed. Independent
# from DOCS_INTERNAL_TOKEN (no fallback). NEVER logged.
DRIVE_INTERNAL_TOKEN=
