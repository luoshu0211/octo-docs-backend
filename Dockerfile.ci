# dmwork private CI Dockerfile.
# GitLab runners should pull base images from the internal TCR mirror instead of Docker Hub.

ARG NODE_IMAGE=tbj7-xtiao-tcr1.tencentcloudcr.com/xtiao-release/node:22-alpine
ARG NPM_REGISTRY=https://registry.npmmirror.com

FROM ${NODE_IMAGE} AS deps

ARG NPM_REGISTRY
ENV NPM_CONFIG_REGISTRY=${NPM_REGISTRY}
ENV npm_config_registry=${NPM_REGISTRY}

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

FROM ${NODE_IMAGE} AS builder

ARG NPM_REGISTRY
ENV NPM_CONFIG_REGISTRY=${NPM_REGISTRY}
ENV npm_config_registry=${NPM_REGISTRY}

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json tsconfig.json ./
COPY src ./src

RUN npm run build

FROM ${NODE_IMAGE} AS prod-deps

ARG NPM_REGISTRY
ENV NPM_CONFIG_REGISTRY=${NPM_REGISTRY}
ENV npm_config_registry=${NPM_REGISTRY}

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

FROM ${NODE_IMAGE} AS runner

ARG GIT_COMMIT=unknown
ARG GIT_BRANCH=unknown
ARG GIT_TAG=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.title="octo-docs-backend" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.ref.name="${GIT_BRANCH}" \
      org.opencontainers.image.version="${GIT_TAG}" \
      org.opencontainers.image.created="${BUILD_DATE}"

WORKDIR /app

ENV NODE_ENV=production
ENV TZ=Asia/Shanghai

RUN addgroup -S octo && adduser -S -u 10001 -G octo octo

COPY --from=prod-deps --chown=octo:octo /app/node_modules ./node_modules
COPY --from=prod-deps --chown=octo:octo /app/package.json ./package.json
COPY --from=builder --chown=octo:octo /app/dist ./dist

USER octo

EXPOSE 3000 1234

CMD ["node", "dist/index.js"]
